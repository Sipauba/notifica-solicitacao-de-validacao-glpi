        "query": "SELECT \n    tv.id AS validacao_id,\n    tv.status,\n    t.id AS numero_chamado,\n    t.name AS titulo,\n    CONCAT(COALESCE(uv.firstname, ''), ' ', COALESCE(uv.realname, '')) AS nome_validador,\n    COALESCE(uv.mobile, uv.phone, uv.phone2) AS telefone_validador\nFROM glpi_ticketvalidations tv\nINNER JOIN glpi_tickets t \n    ON t.id = tv.tickets_id\nINNER JOIN glpi_users uv \n    ON uv.id = tv.users_id_validate\nWHERE tv.NOTIFICADO = 0;",
