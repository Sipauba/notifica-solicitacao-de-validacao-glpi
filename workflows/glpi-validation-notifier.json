    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    let telefone = item.json.telefone_validador || '';\n\n    // Converte para texto\n    telefone = String(telefone);\n\n    // Remove tudo que não for número\n    telefone = telefone.replace(/\\D/g, '');\n\n    // Remove zeros no início\n    telefone = telefone.replace(/^0+/, '');\n\n    // Se tiver número e não começar com 55, adiciona\n    if (telefone && !telefone.startsWith('55')) {\n        telefone = '55' + telefone;\n    }\n\n    // Validação: precisa ter 55 + DDD + número\n    // Ex.: 5511999999999 ou 5511988888888 (números fictícios)\n    if (telefone.length >= 12 && telefone.length <= 13) {\n        item.json.telefone_formatado = telefone;\n        item.json.telefone_valido = true;\n        item.json.erro_telefone = null;\n    } else {\n        item.json.telefone_formatado = null;\n        item.json.telefone_valido = false;\n        item.json.erro_telefone = `Telefone inválido: ${telefone}`;\n    }\n\n    return item;\n});"
      },
